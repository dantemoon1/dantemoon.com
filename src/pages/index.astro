---
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import { site, projects, contact } from '../data/site';

// A receipt-style barcode: bar widths come from the domain's characters.
const bars = [...site.domain].flatMap((c) => {
  const n = c.charCodeAt(0);
  return [1 + (n % 3), 1 + ((n >> 2) % 2), 1 + ((n >> 3) % 3), 1];
});
let bx = 0;
const barRects = bars.map((w, i) => {
  const r = { x: bx, w, fill: i % 2 === 0 };
  bx += w;
  return r;
});
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{site.name}</title>
    <meta name="description" content={site.description} />
  </head>
  <body class="refreshing">
    <main class="receipt">
      <header>
        <p class="brand">{site.domain}</p>
        <p>Thank you for stopping by.</p>
        <p class="printed">Printed <span id="printed">today</span></p>
      </header>

      <hr />

      <section>
        <h2>Now</h2>
        <p class="name">{site.name}</p>
        <p>{site.now}</p>
      </section>

      <hr />

      <section>
        <h2>In this edition</h2>
        <ol class="items">
          {
            projects.map((p, i) => (
              <li>
                <a href={p.url} target="_blank" rel="noopener" class="item">
                  <span class="row">
                    <span class="item-name">{String(i + 1).padStart(2, '0')} {p.name}</span>
                    <span class="leader" aria-hidden="true" />
                    <span class="go">↗</span>
                  </span>
                  <span class="blurb">{p.blurb}</span>
                  <canvas class="dither" data-src={p.image} data-crop={p.crop.join(',')} aria-label={`Screenshot of ${p.name}`} role="img" />
                  <span class="host">{p.host}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </section>

      <hr />

      <section>
        <h2>Reach me</h2>
        <dl class="contact">
          {
            contact.map((c) => (
              <>
                <dt>{c.label}</dt>
                <dd>
                  <a href={c.url}>{c.value}</a>
                </dd>
              </>
            ))
          }
        </dl>
      </section>

      <p class="stars" aria-hidden="true">*&nbsp;&nbsp;&nbsp;*&nbsp;&nbsp;&nbsp;*</p>

      <footer>
        <p>Thank you for your business.</p>
        <p>{site.domain}</p>
        <svg class="barcode" viewBox={`0 0 ${bx} 10`} preserveAspectRatio="none" aria-hidden="true">
          {barRects.filter((r) => r.fill).map((r) => <rect x={r.x} width={r.w} height="10" />)}
        </svg>
      </footer>
    </main>

    <div class="flash" aria-hidden="true"></div>

    <script>
      // "Printed" timestamp in Chicago time.
      document.getElementById('printed')!.textContent = new Date().toLocaleString('en-US', {
        timeZone: 'America/Chicago',
        weekday: 'short',
        month: 'short',
        day: 'numeric',
        year: 'numeric',
        hour: 'numeric',
        minute: '2-digit',
      }) + ' CT';

      // Atkinson dithering, the classic 1-bit look of e-ink and early Macs.
      const INK = [42, 42, 40];
      const PAPER = [226, 224, 217];
      const SCALE = 1.5; // each dithered dot is SCALE css pixels

      function dither(canvas: HTMLCanvasElement, img: HTMLImageElement) {
        const [cx, cy, cw, ch] = canvas.dataset.crop!.split(',').map(Number);
        const sx = cx * img.naturalWidth, sy = cy * img.naturalHeight;
        const sw = cw * img.naturalWidth, sh = ch * img.naturalHeight;
        const w = Math.round(canvas.clientWidth / SCALE);
        const h = Math.round((w * sh) / sw);
        canvas.width = w;
        canvas.height = h;
        const ctx = canvas.getContext('2d')!;
        ctx.drawImage(img, sx, sy, sw, sh, 0, 0, w, h);
        const data = ctx.getImageData(0, 0, w, h);
        const px = data.data;
        const gray = new Float32Array(w * h);
        for (let i = 0; i < w * h; i++) {
          gray[i] = 0.299 * px[i * 4] + 0.587 * px[i * 4 + 1] + 0.114 * px[i * 4 + 2];
        }
        const spread = [[1, 0], [2, 0], [-1, 1], [0, 1], [1, 1], [0, 2]];
        for (let y = 0; y < h; y++) {
          for (let x = 0; x < w; x++) {
            const i = y * w + x;
            const out = gray[i] < 128 ? 0 : 255;
            const err = (gray[i] - out) / 8;
            gray[i] = out;
            for (const [dx, dy] of spread) {
              const nx = x + dx, ny = y + dy;
              if (nx >= 0 && nx < w && ny < h) gray[ny * w + nx] += err;
            }
          }
        }
        for (let i = 0; i < w * h; i++) {
          const c = gray[i] === 0 ? INK : PAPER;
          px[i * 4] = c[0];
          px[i * 4 + 1] = c[1];
          px[i * 4 + 2] = c[2];
          px[i * 4 + 3] = 255;
        }
        ctx.putImageData(data, 0, 0);
      }

      document.querySelectorAll<HTMLCanvasElement>('canvas.dither').forEach((canvas) => {
        const img = new Image();
        img.onload = () => dither(canvas, img);
        img.src = canvas.dataset.src!;
      });

      // E-ink full refresh on load: inverted, black, white, then the page.
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const steps: [string, number][] = reduce
        ? [['done', 0]]
        : [['invert', 140], ['black', 110], ['white', 110], ['done', 0]];
      let t = 0;
      for (const [state, ms] of steps) {
        setTimeout(() => {
          document.body.dataset.flash = state;
          if (state === 'done') document.body.classList.remove('refreshing');
        }, t);
        t += ms;
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --panel: #d6d4cd;
    --paper: #e2e0d9;
    --ink: #2a2a28;
    --faint: #6d6b65;
  }
  * { box-sizing: border-box; }
  html {
    background: var(--panel);
    color: var(--ink);
    font: 15px/1.6 'IBM Plex Mono', ui-monospace, Menlo, monospace;
    -webkit-font-smoothing: antialiased;
  }
  body { margin: 0; padding: 4rem 1rem 6rem; min-height: 100vh; }
  p { margin: 0; }
  a { color: inherit; text-decoration: none; }

  .receipt {
    max-width: 27rem;
    margin: 0 auto;
    padding: 2.5rem 2rem 2rem;
    background: var(--paper);
    box-shadow: 0 1px 0 rgb(0 0 0 / 0.06), 0 18px 40px -18px rgb(0 0 0 / 0.35);
    /* torn bottom edge */
    --tooth: 10px;
    mask:
      linear-gradient(#000 0 0) top / 100% calc(100% - var(--tooth)) no-repeat,
      conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) bottom / calc(var(--tooth) * 2) var(--tooth) repeat-x;
  }

  header { text-align: center; }
  .brand {
    display: inline-block;
    font-size: 1.5rem;
    font-weight: 600;
    padding: 0.6rem 1.4rem;
    border: 1.5px dashed var(--faint);
    border-radius: 4px;
    margin-bottom: 1.25rem;
  }
  .printed { color: var(--faint); font-size: 0.8rem; }

  hr { border: 0; border-top: 1.5px solid var(--ink); margin: 1.5rem 0; }
  h2 {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0 0 0.75rem;
  }
  .name { font-size: 1.35rem; font-weight: 600; }

  .items { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.5rem; }
  .item { display: block; padding: 0.5rem; margin: -0.5rem; }
  .row { display: flex; align-items: baseline; gap: 0.5rem; }
  .item-name { font-weight: 600; font-size: 1.05rem; white-space: nowrap; }
  .leader { flex: 1; border-bottom: 2px dotted var(--faint); transform: translateY(-0.3em); }
  .blurb, .host { display: block; }
  .host { color: var(--faint); font-size: 0.8rem; }
  .dither {
    display: block;
    width: 100%;
    margin: 0.6rem 0 0.3rem;
    image-rendering: pixelated;
    border: 1.5px solid var(--ink);
  }

  /* e-ink style hover: a hard inversion, no easing */
  .item:hover, .item:focus-visible, .contact a:hover, .contact a:focus-visible {
    background: var(--ink);
    color: var(--paper);
    outline: none;
  }
  .item:hover .host, .item:hover .leader { color: var(--paper); border-color: var(--paper); }
  .item:hover .dither { filter: invert(1); border-color: var(--paper); }

  .contact { display: grid; grid-template-columns: 6rem 1fr; margin: 0; }
  .contact dt { color: var(--faint); }
  .contact dd { margin: 0; }
  .contact a { text-decoration: underline; text-underline-offset: 3px; }

  .stars { text-align: center; margin: 2rem 0 1.5rem; font-size: 1.1rem; }
  footer { text-align: center; }
  .barcode { width: 70%; height: 44px; margin: 1.5rem auto 0.5rem; display: block; fill: var(--ink); }

  /* the refresh flash */
  .flash { position: fixed; inset: 0; pointer-events: none; z-index: 10; }
  body[data-flash='invert'] { filter: invert(1); }
  body[data-flash='black'] .flash { background: #111; }
  body[data-flash='white'] .flash { background: #f4f3ef; }
  body.refreshing .receipt { visibility: hidden; }
  body[data-flash='invert'] .receipt { visibility: visible; }

  @media (max-width: 480px) {
    body { padding: 1.5rem 0.75rem 3rem; }
    .receipt { padding: 2rem 1.25rem 1.5rem; }
    .contact { grid-template-columns: 5rem 1fr; }
  }
</style>
