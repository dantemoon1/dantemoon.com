---
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';
import { site, nowCollage, projects, contact } from '../data/site';

// A receipt-style barcode: bar widths come from the domain's characters.
const bars = [...site.domain].flatMap((c) => {
  const n = c.charCodeAt(0);
  return [1 + (n % 3), 1 + ((n >> 2) % 2), 1 + ((n >> 3) % 3), 1];
});
let bx = 0;
const barRects = bars.map((w, i) => {
  const r = { x: bx, w, fill: i % 2 === 0 };
  bx += w;
  return r;
});
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{site.name}</title>
    <meta name="description" content={site.description} />
  </head>
  <body class="refreshing">
    <main class="receipt">
      <header>
        <p class="brand">{site.domain}</p>
        <p>Thank you for stopping by.</p>
        <p class="printed">Printed <span id="printed">today</span></p>
      </header>

      <hr />

      <section class="now" tabindex="0">
        <h2>Now</h2>
        <p class="name">{site.name}</p>
        <p>{site.now}</p>
      </section>

      <hr />

      <section>
        <h2>Made to order</h2>
        <ol class="items">
          {
            projects.map((p, i) => (
              <li>
                <a href={p.url} target="_blank" rel="noopener" class="item" data-index={i}>
                  <span class="row">
                    <span class="item-name">{String(i + 1).padStart(2, '0')} {p.name}</span>
                    <span class="leader" aria-hidden="true" />
                    <span class="go">↗</span>
                  </span>
                  <span class="blurb">{p.blurb}</span>
                  <canvas class="dither" data-src={p.image} data-crop={p.crop.join(',')} aria-label={`Screenshot of ${p.name}`} role="img" />
                  <span class="host">{p.host}</span>
                </a>
              </li>
            ))
          }
        </ol>
        <p class="total">
          <span>Order total</span>
          <span class="leader" aria-hidden="true"></span>
          <span>{projects.length}</span>
        </p>
      </section>

      <hr />

      <section>
        <h2>Reach me</h2>
        <ul class="contact">
          {
            contact.map((c) => (
              <li>
                <a href={c.url} target={c.url.startsWith('mailto:') ? undefined : '_blank'} rel="noopener">
                  <canvas class="icon" data-icon={c.label} aria-hidden="true" />
                  <span>{c.value}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <p class="stars" aria-hidden="true">*&nbsp;&nbsp;&nbsp;*&nbsp;&nbsp;&nbsp;*</p>

      <footer>
        <p>Thank you for your business.</p>
        <p>{site.domain}</p>
        <svg class="barcode" viewBox={`0 0 ${bx} 10`} preserveAspectRatio="none" aria-hidden="true">
          {barRects.filter((r) => r.fill).map((r) => <rect x={r.x} width={r.w} height="10" />)}
        </svg>
      </footer>
    </main>

    <figure class="display" aria-hidden="true">
      <div class="screen">
        <p class="now-showing">Now showing <span class="display-count"></span></p>
        <canvas class="display-canvas"></canvas>
        <p class="display-name"></p>
        <p class="display-host"></p>
      </div>
    </figure>

    <script type="application/json" id="projects" set:html={JSON.stringify(projects)} />
    <script type="application/json" id="now-collage" set:html={JSON.stringify(nowCollage)} />

    <div class="flash" aria-hidden="true"></div>

    <script>
      // "Printed" timestamp in Chicago time.
      document.getElementById('printed')!.textContent = new Date().toLocaleString('en-US', {
        timeZone: 'America/Chicago',
        weekday: 'short',
        month: 'short',
        day: 'numeric',
        year: 'numeric',
        hour: 'numeric',
        minute: '2-digit',
      }) + ' CT';

      // Atkinson dithering, the classic 1-bit look of e-ink and early Macs.
      const INK = [42, 42, 40];
      const PAPER = [226, 224, 217];
      const SCALE = 1.5; // each dithered dot is SCALE css pixels

      // Every screenshot is shown at this shape, so the display doesn't jump between projects.
      const ASPECT = 2;

      function dither(
        canvas: HTMLCanvasElement,
        img: HTMLImageElement | HTMLCanvasElement,
        crop = [0, 0, 1, 1],
        aspect?: number,
        scale = SCALE,
        opts: { fit?: string; tone?: string } = {},
      ) {
        const iw = img instanceof HTMLImageElement ? img.naturalWidth : img.width;
        const ih = img instanceof HTMLImageElement ? img.naturalHeight : img.height;
        let sw = crop[2] * iw, sh = crop[3] * ih;
        let sx = crop[0] * iw, sy = crop[1] * ih;
        if (aspect) {
          // grow the crop around its center to the target shape, shrinking only if it hits the image edge
          const mx = sx + sw / 2, my = sy + sh / 2;
          if (sw / sh > aspect) {
            sh = Math.min(ih, sw / aspect);
            sw = sh * aspect;
          } else {
            sw = Math.min(iw, sh * aspect);
            sh = sw / aspect;
          }
          sx = Math.min(Math.max(mx - sw / 2, 0), iw - sw);
          sy = Math.min(Math.max(my - sh / 2, 0), ih - sh);
        }
        const w = Math.round(canvas.clientWidth / scale);
        const h = Math.round(opts.fit === 'contain' && aspect ? w / aspect : (w * sh) / sw);
        canvas.width = w;
        canvas.height = h;
        const ctx = canvas.getContext('2d')!;
        ctx.fillStyle = '#fff';
        ctx.fillRect(0, 0, w, h);
        if (opts.tone) ctx.filter = opts.tone;
        if (opts.fit === 'contain') {
          // a logo: whole, centered, with room around it
          const k = Math.min((w * 0.7) / iw, (h * 0.7) / ih);
          ctx.drawImage(img, (w - iw * k) / 2, (h - ih * k) / 2, iw * k, ih * k);
        } else {
          ctx.drawImage(img, sx, sy, sw, sh, 0, 0, w, h);
        }
        ctx.filter = 'none';
        const data = ctx.getImageData(0, 0, w, h);
        const px = data.data;
        const gray = new Float32Array(w * h);
        for (let i = 0; i < w * h; i++) {
          gray[i] = 0.299 * px[i * 4] + 0.587 * px[i * 4 + 1] + 0.114 * px[i * 4 + 2];
        }
        const spread = [[1, 0], [2, 0], [-1, 1], [0, 1], [1, 1], [0, 2]];
        for (let y = 0; y < h; y++) {
          for (let x = 0; x < w; x++) {
            const i = y * w + x;
            const out = gray[i] < 128 ? 0 : 255;
            const err = (gray[i] - out) / 8;
            gray[i] = out;
            for (const [dx, dy] of spread) {
              const nx = x + dx, ny = y + dy;
              if (nx >= 0 && nx < w && ny < h) gray[ny * w + nx] += err;
            }
          }
        }
        for (let i = 0; i < w * h; i++) {
          const c = gray[i] === 0 ? INK : PAPER;
          px[i * 4] = c[0];
          px[i * 4 + 1] = c[1];
          px[i * 4 + 2] = c[2];
          px[i * 4 + 3] = 255;
        }
        ctx.putImageData(data, 0, 0);
      }

      // Contact icons: drawn large with a top-to-bottom shade, then dithered down.
      const ICON_PATHS: Record<string, string> = {
        github:
          'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.930 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.910 1.23 3.220 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
        linkedin:
          'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.928 1.636-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 4.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
        email: 'M1 4h22v16H1z',
      };

      function iconSource(name: string) {
        const S = 120;
        const c = document.createElement('canvas');
        c.width = c.height = S;
        const ctx = c.getContext('2d')!;
        ctx.fillStyle = '#fff';
        ctx.fillRect(0, 0, S, S);
        ctx.scale(S / 26, S / 26);
        ctx.translate(1, 1);
        const shade = ctx.createLinearGradient(0, 0, 0, 24);
        shade.addColorStop(0, '#000');
        shade.addColorStop(1, '#9a9a9a');
        ctx.fillStyle = shade;
        ctx.fill(new Path2D(ICON_PATHS[name]));
        if (name === 'email') {
          ctx.strokeStyle = '#fff';
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.moveTo(1.5, 4.5);
          ctx.lineTo(12, 13);
          ctx.lineTo(22.5, 4.5);
          ctx.stroke();
        }
        return c;
      }

      document.querySelectorAll<HTMLCanvasElement>('canvas.icon').forEach((canvas) => {
        dither(canvas, iconSource(canvas.dataset.icon!), undefined, undefined, 1.5);
      });

      const images = new Map<string, Promise<HTMLImageElement>>();
      function load(src: string) {
        if (!images.has(src)) {
          images.set(src, new Promise((resolve) => {
            const img = new Image();
            img.onload = () => resolve(img);
            img.src = src;
          }));
        }
        return images.get(src)!;
      }

      // Mobile: screenshots sit inline in the receipt.
      document.querySelectorAll<HTMLCanvasElement>('canvas.dither').forEach(async (canvas) => {
        const img = await load(canvas.dataset.src!);
        if (canvas.clientWidth) dither(canvas, img, canvas.dataset.crop!.split(',').map(Number), ASPECT);
      });

      // Desktop: an e-ink display beside the receipt. Hovering a project shows it;
      // hovering "Now" shows Chicago, Optum and UIUC together as a collage.
      type Slide = { name: string; host: string; image: string; crop?: number[]; fit?: string; tone?: string };
      const projects: Slide[] = JSON.parse(document.getElementById('projects')!.textContent!);
      type Collage = {
        name: string;
        credit: string;
        items: { image: string; x: number; y: number; w: number; rotate: number; tone?: string }[];
      };
      const collage: Collage = JSON.parse(document.getElementById('now-collage')!.textContent!);

      // Draw the collage at full size on a blank canvas, then dither it like any other image.
      let collageCanvas: Promise<HTMLCanvasElement> | undefined;
      function buildCollage() {
        collageCanvas ??= Promise.all(collage.items.map((it) => load(it.image))).then((imgs) => {
          const W = 1600, H = W / ASPECT;
          const c = document.createElement('canvas');
          c.width = W;
          c.height = H;
          const ctx = c.getContext('2d')!;
          ctx.fillStyle = '#fff';
          ctx.fillRect(0, 0, W, H);
          collage.items.forEach((it, i) => {
            const img = imgs[i];
            const w = it.w * W, h = (w * img.naturalHeight) / img.naturalWidth;
            ctx.save();
            ctx.translate(it.x * W, it.y * H);
            ctx.rotate((it.rotate * Math.PI) / 180);
            if (it.tone) ctx.filter = it.tone;
            ctx.drawImage(img, -w / 2, -h / 2, w, h);
            ctx.restore();
          });
          return c;
        });
        return collageCanvas;
      }
      const display = document.querySelector<HTMLElement>('.display')!;
      const screen = display.querySelector<HTMLCanvasElement>('.display-canvas')!;
      const nowSection = document.querySelector<HTMLElement>('.now')!;
      const REFRESH_MS = 420;
      let active = '';
      let drawToken = 0;

      async function render(slide: Slide | 'now', count: string) {
        const token = ++drawToken;
        const img = slide === 'now' ? await buildCollage() : await load(slide.image);
        if (token !== drawToken) return;
        // partial refresh: the old image inverts, then the new one is drawn
        display.classList.add('flicker');
        setTimeout(() => {
          if (token !== drawToken) return;
          if (slide === 'now') {
            dither(screen, img, undefined, ASPECT);
            display.querySelector('.display-name')!.textContent = collage.name;
            display.querySelector('.display-host')!.textContent = collage.credit;
          } else {
            dither(screen, img, slide.crop, ASPECT, SCALE, slide);
            display.querySelector('.display-name')!.textContent = slide.name;
            display.querySelector('.display-host')!.textContent = slide.host;
          }
          display.querySelector('.display-count')!.textContent = count;
          display.classList.remove('flicker');
        }, REFRESH_MS);
      }

      function select(key: string) {
        if (key === active || !display.offsetParent) return;
        active = key;
        nowSection.classList.toggle('selected', key === 'now');
        document.querySelectorAll('.item').forEach((el, j) => el.classList.toggle('selected', key === `p${j}`));
        if (key === 'now') {
          render('now', '');
        } else {
          const i = Number(key.slice(1));
          render(projects[i], `${i + 1}/${projects.length}`);
        }
      }

      document.querySelectorAll<HTMLElement>('.item').forEach((el) => {
        const key = `p${el.dataset.index}`;
        el.addEventListener('mouseenter', () => select(key));
        el.addEventListener('focus', () => select(key));
      });
      nowSection.addEventListener('mouseenter', () => select('now'));
      nowSection.addEventListener('focus', () => select('now'));
      select('now');

      // Desktop: shrink everything slightly if the window is too short for the receipt.
      function fit() {
        document.body.style.zoom = '';
        if (!display.offsetParent) return;
        const h = document.querySelector<HTMLElement>(".receipt")!.offsetHeight + 96;
        if (h > innerHeight) document.body.style.zoom = String(innerHeight / h);
      }
      fit();
      addEventListener('resize', fit);
      addEventListener('resize', () => {
        const key = active || 'now';
        active = '';
        select(key);
      });

      // E-ink full refresh on load: inverted, black, white, then the page.
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const steps: [string, number][] = reduce
        ? [['done', 0]]
        : [['invert', 650], ['black', 450], ['white', 450], ['black', 350], ['white', 500], ['done', 0]];
      let t = 0;
      for (const [state, ms] of steps) {
        setTimeout(() => {
          document.body.dataset.flash = state;
          if (state === 'done') document.body.classList.remove('refreshing');
        }, t);
        t += ms;
      }
    </script>
  </body>
</html>

<style is:global>
  :root {
    --panel: #d6d4cd;
    --paper: #e2e0d9;
    --ink: #2a2a28;
    --faint: #6d6b65;
  }
  * { box-sizing: border-box; }
  html {
    background: var(--panel);
    color: var(--ink);
    font: 15px/1.6 'IBM Plex Mono', ui-monospace, Menlo, monospace;
    -webkit-font-smoothing: antialiased;
  }
  body { margin: 0; padding: 4rem 1rem 6rem; min-height: 100vh; }
  p { margin: 0; }
  a { color: inherit; text-decoration: none; }

  .receipt {
    max-width: 27rem;
    margin: 0 auto;
    padding: 2.5rem 2rem 2rem;
    background: var(--paper);
    box-shadow: 0 1px 0 rgb(0 0 0 / 0.06), 0 18px 40px -18px rgb(0 0 0 / 0.35);
    /* torn bottom edge */
    --tooth: 10px;
    mask:
      linear-gradient(#000 0 0) top / 100% calc(100% - var(--tooth)) no-repeat,
      conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) bottom / calc(var(--tooth) * 2) var(--tooth) repeat-x;
  }

  header { text-align: center; }
  .brand {
    display: inline-block;
    font-size: 1.5rem;
    font-weight: 600;
    padding: 0.6rem 1.4rem;
    border: 1.5px dashed var(--faint);
    border-radius: 4px;
    margin-bottom: 1.25rem;
  }
  .printed { color: var(--faint); font-size: 0.8rem; }

  hr { border: 0; border-top: 1.5px solid var(--ink); margin: 1.5rem 0; }
  h2 {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0 0 0.75rem;
  }
  .name { font-size: 1.35rem; font-weight: 600; }

  .items { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.5rem; }
  .item { display: block; padding: 0.5rem; margin: -0.5rem; }
  .row { display: flex; align-items: baseline; gap: 0.5rem; }
  .item-name { font-weight: 600; font-size: 1.05rem; white-space: nowrap; }
  .leader { flex: 1; border-bottom: 2px dotted var(--faint); transform: translateY(-0.3em); }
  .blurb, .host { display: block; }
  .host { color: var(--faint); font-size: 0.8rem; }
  .dither {
    display: block;
    width: 100%;
    margin: 0.6rem 0 0.3rem;
    image-rendering: pixelated;
    border: 1.5px solid var(--ink);
  }

  /* e-ink style hover: a hard inversion, no easing */
  .item:hover, .item:focus-visible, .contact a:hover, .contact a:focus-visible {
    background: var(--ink);
    color: var(--paper);
    outline: none;
  }
  .item:hover .host, .item:hover .leader { color: var(--paper); border-color: var(--paper); }
  .item:hover .dither { filter: invert(1); border-color: var(--paper); }

  .total {
    display: flex; align-items: baseline; gap: 0.5rem;
    margin-top: 1.25rem; padding-top: 0.75rem; border-top: 1.5px dashed var(--faint);
    font-weight: 600; text-transform: uppercase; font-size: 0.85rem; letter-spacing: 0.08em;
  }

  .contact { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  .contact a { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.15rem 0.4rem 0.15rem 0.15rem; margin-left: -0.15rem; }
  .contact span { text-decoration: underline; text-underline-offset: 3px; }
  .icon { width: 33px; height: 33px; image-rendering: pixelated; flex-shrink: 0; }
  .contact a:hover .icon, .contact a:focus-visible .icon { filter: invert(1); }

  .stars { text-align: center; margin: 2rem 0 1.5rem; font-size: 1.1rem; }
  footer { text-align: center; }
  .barcode { width: 70%; height: 44px; margin: 1.5rem auto 0.5rem; display: block; fill: var(--ink); }

  /* the refresh flash */
  .flash { position: fixed; inset: 0; pointer-events: none; z-index: 10; }
  body[data-flash='invert'] { filter: invert(1); }
  body[data-flash='black'] .flash { background: #111; }
  body[data-flash='white'] .flash { background: #f4f3ef; }
  body.refreshing :is(.receipt, .display) { visibility: hidden; }
  body[data-flash='invert'] :is(.receipt, .display) { visibility: visible; }

  .display { display: none; }

  /* Desktop: text-only receipt with the e-ink display beside it */
  @media (min-width: 1040px) {
    body {
      display: flex; align-items: center; gap: 4rem;
      padding: 2.5rem 4rem 2.5rem 3rem;
    }
    .receipt { margin: 0; padding: 1.75rem 2rem 1.5rem; max-width: none; width: 34rem; flex-shrink: 0; }
    .receipt .dither, .receipt .host { display: none; }
    .brand { margin-bottom: 0.75rem; }
    .contact { display: flex; justify-content: space-between; gap: 0.5rem; }
    .items { gap: 1rem; }
    hr { margin: 1.15rem 0; }
    .stars { margin: 1.25rem 0 1rem; }
    .barcode { margin-top: 0.75rem; height: 30px; }
    .item.selected { background: var(--ink); color: var(--paper); }
    .now { padding: 0.5rem; margin: -0.5rem; outline: none; cursor: default; }
    .now.selected { background: var(--ink); color: var(--paper); }
    .item.selected .host, .item.selected .leader { color: var(--paper); border-color: var(--paper); }

    .display {
      display: block; margin: 0 auto; flex: 1; max-width: 64rem;
      padding: 1.4rem; background: #ecebe6; border-radius: 10px;
      box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.08), 0 18px 40px -18px rgb(0 0 0 / 0.35);
    }
    .screen {
      background: var(--paper); padding: 1.25rem; border-radius: 2px;
      box-shadow: inset 0 1px 4px rgb(0 0 0 / 0.18);
    }
    .now-showing {
      display: flex; justify-content: space-between;
      font-size: 0.7rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
      border-bottom: 1.5px solid var(--ink); padding-bottom: 0.6rem; margin-bottom: 1rem;
    }
    .display-canvas { display: block; width: 100%; image-rendering: pixelated; border: 1.5px solid var(--ink); }
    .display-name { font-weight: 600; font-size: 1.4rem; margin-top: 1rem; }
    .display-host { color: var(--faint); font-size: 0.8rem; }
    .display.flicker .screen { filter: invert(1); }
  }

  @media (max-width: 480px) {
    body { padding: 1.5rem 0.75rem 3rem; }
    .receipt { padding: 2rem 1.25rem 1.5rem; }
  }
</style>
