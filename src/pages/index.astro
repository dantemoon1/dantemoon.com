---
import { site, loop, lines } from '../data/site';

const stops = {
  loop: { name: loop.name, line: 'All lines', color: '#5b4636', blurb: loop.blurb },
  ...Object.fromEntries(
    lines.flatMap((l) =>
      l.stations.map((s) => [s.id, { name: s.name, line: l.name, color: l.color, blurb: s.blurb, link: s.link }]),
    ),
  ),
};

const labelPos = {
  right: { dx: 20, dy: 6, anchor: 'start' },
  left: { dx: -20, dy: 6, anchor: 'end' },
  above: { dx: 0, dy: -20, anchor: 'middle' },
  below: { dx: 0, dy: 32, anchor: 'middle' },
} as const;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{site.name}</title>
    <meta name="description" content={site.tagline} />
  </head>
  <body>
    <header class="title">
      <h1>{site.name}</h1>
      <p>{site.tagline}</p>
      <p class="hint">Click a stop to look around.</p>
    </header>

    <svg class="map" viewBox="0 0 1000 720" preserveAspectRatio="xMidYMid meet" role="img" aria-label="A transit map of Dante's work">
      <!-- Lake Michigan and the river sit under the tracks -->
      <path class="water" d="M 830 0 C 805 140, 860 250, 815 380 S 785 610, 830 720 L 1000 720 L 1000 0 Z" />
      <text class="lake-label" x="905" y="380" transform="rotate(90 905 380)">LAKE MICHIGAN</text>
      <path class="river" d="M 822 300 L 480 300 C 455 300, 450 290, 430 270 L 330 170 L 330 0" />
      <path class="river" d="M 480 300 C 455 300, 445 315, 445 340 L 445 720" />

      {lines.map((l) => <path class="track" data-line={l.id} d={l.path} stroke={l.color} />)}

      <!-- The Loop -->
      <g class="stop loop" data-stop="loop" tabindex="0" role="button" aria-label="The Loop: about me">
        <rect class="loop-track" x="520" y="330" width="120" height="90" rx="14" />
        <rect class="loop-inner" x="527" y="337" width="106" height="76" rx="9" />
        <text class="loop-label" x="580" y="372">THE</text>
        <text class="loop-label" x="580" y="392">LOOP</text>
        <rect class="train" x="-9" y="-5" width="18" height="10" rx="3">
          <animateMotion dur="9s" repeatCount="indefinite" rotate="auto" path="M 534 330 L 626 330 Q 640 330 640 344 L 640 406 Q 640 420 626 420 L 534 420 Q 520 420 520 406 L 520 344 Q 520 330 534 330 Z" />
        </rect>
      </g>

      {
        lines.map((l) =>
          l.stations.map((s) => {
            const p = labelPos[s.label];
            return (
              <g class:list={['stop', { terminal: s.terminal }]} data-stop={s.id} data-line={l.id} tabindex="0" role="button" aria-label={s.name}>
                <circle class="hit" cx={s.x} cy={s.y} r="24" />
                <circle class="dot" cx={s.x} cy={s.y} r={s.terminal ? 11 : 8} stroke={s.terminal ? l.color : undefined} />
                <text class="stop-label" x={s.x + p.dx} y={s.y + p.dy} text-anchor={p.anchor}>{s.name}</text>
              </g>
            );
          }),
        )
      }
    </svg>

    <ul class="legend">
      {lines.map((l) => <li><span style={`background:${l.color}`}></span>{l.name}</li>)}
    </ul>

    <aside class="card" hidden aria-live="polite">
      <button class="close" aria-label="Close">×</button>
      <p class="card-line"><span class="chip"></span><span class="line-name"></span></p>
      <h2 class="card-name"></h2>
      <p class="card-blurb"></p>
      <a class="card-link" hidden></a>
    </aside>

    <script type="application/json" id="stops" set:html={JSON.stringify(stops)} />
    <script>
      type Stop = { name: string; line: string; color: string; blurb: string; link?: { label: string; url: string } };
      const stops: Record<string, Stop> = JSON.parse(document.getElementById('stops')!.textContent!);
      const card = document.querySelector<HTMLElement>('.card')!;
      const q = <T extends HTMLElement>(sel: string) => card.querySelector<T>(sel)!;

      function open(id: string) {
        const s = stops[id];
        q('.chip').style.background = s.color;
        q('.line-name').textContent = s.line;
        q('.card-name').textContent = s.name;
        q('.card-blurb').textContent = s.blurb;
        const a = q<HTMLAnchorElement>('.card-link');
        a.hidden = !s.link;
        if (s.link) {
          a.href = s.link.url;
          a.textContent = `${s.link.label} →`;
          a.target = s.link.url.startsWith('mailto:') ? '' : '_blank';
        }
        card.style.setProperty('--line', s.color);
        card.hidden = false;
        document.querySelectorAll('.stop').forEach((el) => el.classList.toggle('active', el.getAttribute('data-stop') === id));
      }

      function close() {
        card.hidden = true;
        document.querySelectorAll('.stop.active').forEach((el) => el.classList.remove('active'));
      }

      document.querySelectorAll<SVGGElement>('.stop').forEach((el) => {
        const id = el.dataset.stop!;
        el.addEventListener('click', () => open(id));
        el.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            open(id);
          }
        });
      });
      q('.close').addEventListener('click', close);
      document.addEventListener('keydown', (e) => e.key === 'Escape' && close());
    </script>
  </body>
</html>

<style is:global>
  :root {
    --paper: #f3efe6;
    --ink: #1d1c1a;
    --muted: #6f6a60;
    --water: #cfe1ee;
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; height: 100%; }
  body {
    background: var(--paper);
    color: var(--ink);
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    overflow: hidden;
  }

  .title { position: fixed; top: 2rem; left: 2rem; z-index: 2; max-width: 22rem; }
  .title h1 { margin: 0; font-size: 2.2rem; letter-spacing: -0.03em; line-height: 1; }
  .title p { margin: 0.5rem 0 0; color: var(--muted); }
  .title .hint { font-size: 0.85rem; }

  .map { width: 100vw; height: 100vh; display: block; }
  .water { fill: var(--water); }
  .river { fill: none; stroke: var(--water); stroke-width: 9; stroke-linejoin: round; }
  .lake-label { fill: #8fb0c6; font-size: 13px; letter-spacing: 0.4em; font-style: italic; text-anchor: middle; }

  .track { fill: none; stroke-width: 10; stroke-linecap: round; stroke-linejoin: round; }

  .loop-track { fill: none; stroke: #5b4636; stroke-width: 12; }
  .loop-inner { fill: var(--paper); stroke: none; }
  .loop-label { font-size: 13px; font-weight: 800; letter-spacing: 0.15em; text-anchor: middle; fill: #5b4636; }
  .train { fill: #f2b705; stroke: var(--ink); stroke-width: 1.5; }

  .stop { cursor: pointer; outline: none; }
  .hit { fill: transparent; }
  .dot { fill: #fff; stroke: var(--ink); stroke-width: 3.5; transition: r 0.15s; }
  .terminal .dot { stroke-width: 5; }
  .stop-label { font-size: 15px; font-weight: 700; fill: var(--ink); paint-order: stroke; stroke: var(--paper); stroke-width: 5px; }
  .stop:hover .dot, .stop:focus-visible .dot, .stop.active .dot { r: 13; }
  .stop:focus-visible .stop-label, .stop.active .stop-label { text-decoration: underline; }
  .loop:hover .loop-track, .loop.active .loop-track { stroke: #3d2e22; }

  .legend {
    position: fixed; left: 2rem; bottom: 2rem; margin: 0; padding: 0.9rem 1.1rem;
    list-style: none; background: #fff; border: 2px solid var(--ink); border-radius: 6px;
    font-size: 0.85rem; font-weight: 700; display: grid; gap: 0.4rem;
  }
  .legend span { display: inline-block; width: 1.6rem; height: 0.45rem; border-radius: 2px; margin-right: 0.6rem; vertical-align: middle; }

  .card {
    position: fixed; right: 2rem; top: 50%; transform: translateY(-50%);
    width: min(22rem, calc(100vw - 2rem)); padding: 1.5rem;
    background: #fff; border: 2px solid var(--ink); border-top: 10px solid var(--line, var(--ink));
    border-radius: 6px; box-shadow: 0 10px 30px rgb(0 0 0 / 0.12); z-index: 3;
    animation: slide 0.2s ease-out;
  }
  .card[hidden] { display: none; }
  @keyframes slide { from { opacity: 0; transform: translate(12px, -50%); } }
  .card-line { margin: 0; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); }
  .chip { display: inline-block; width: 0.7rem; height: 0.7rem; border-radius: 50%; margin-right: 0.5rem; vertical-align: -1px; }
  .card-name { margin: 0.5rem 0 0.75rem; font-size: 1.6rem; letter-spacing: -0.02em; }
  .card-blurb { margin: 0 0 1rem; line-height: 1.55; }
  .card-link { color: var(--ink); font-weight: 700; text-decoration-color: var(--line); text-decoration-thickness: 3px; text-underline-offset: 4px; }
  .close { position: absolute; top: 0.6rem; right: 0.8rem; border: 0; background: none; font-size: 1.5rem; cursor: pointer; color: var(--muted); }

  @media (max-width: 700px) {
    body { overflow: auto; }
    .title { position: static; padding: 1.5rem 1.5rem 0; }
    .map { height: auto; min-height: 60vh; }
    .legend { position: static; margin: 0 1.5rem 1.5rem; }
    .card { top: auto; bottom: 1rem; right: 1rem; left: 1rem; width: auto; transform: none; }
    @keyframes slide { from { opacity: 0; transform: translateY(12px); } }
  }
</style>
