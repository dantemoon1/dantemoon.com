{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dantemoon-com",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "dantemoon.com", "custom_domain": true },
    { "pattern": "www.dantemoon.com", "custom_domain": true }
  ]
}
